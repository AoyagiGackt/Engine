    },
    {
      "action": "press",
      "key": "Enter"
    },
    {
      "action": "waitSceneChange",
      "timeout": 20
    },
    {
      "action": "mark",
      "text": "トレーニングへ行って操作する"
    },
    {
      "action": "changeScene",
      "scene": "MAP"
    },
    {
      "action": "waitScene",
      "scene": "MAP",
      "timeout": 20
    },
    {
      "action": "wait",
